// Secrets.xcconfig.example
// ──────────────────────────────────────────────────────────
// 이 파일을 같은 폴더에 `Secrets.xcconfig` 로 복사한 뒤 값을 채운다.
// Secrets.xcconfig 는 .gitignore 로 제외되며 절대 커밋하지 않는다.
//
// 값 확인: Naver Cloud Platform 콘솔 → Application(Passage) → 인증 정보
//   Client ID     (X-NCP-APIGW-API-KEY-ID)
//   Client Secret (X-NCP-APIGW-API-KEY)
// ──────────────────────────────────────────────────────────

NAVER_MAP_CLIENT_ID = YOUR_NAVER_MAP_CLIENT_ID
NAVER_MAP_CLIENT_SECRET = YOUR_NAVER_MAP_CLIENT_SECRET
